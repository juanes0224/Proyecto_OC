// Grafico.vm - Rutinas para dibujar celdas de 16 x 16 pixeles.
// Autor 1: Jeronimo Gutierrez
// Autor 2: Juan Esteban Grisales

// Grafico.direccion(fila, col): 16384 + fila*512 + col, sumando 512 por fila.
function Grafico.direccion 1
push constant 16384
push argument 1
add
pop local 0
label DIRECCION_CICLO
push argument 0
push constant 1
lt
if-goto DIRECCION_FIN
push local 0
push constant 512
add
pop local 0
push argument 0
push constant 1
sub
pop argument 0
goto DIRECCION_CICLO
label DIRECCION_FIN
push local 0
return

// Grafico.dibujarCelda(fila, col, sprite): copia las 16 palabras del sprite.
function Grafico.dibujarCelda 2
push argument 0
push argument 1
call Grafico.direccion 2
pop local 0
push constant 0
pop local 1
label DIBUJAR_CICLO
push local 1
push constant 16
eq
if-goto DIBUJAR_FIN
push argument 2
push local 1
add
pop pointer 0
push local 0
pop pointer 1
push this 0
pop that 0
push local 0
push constant 32
add
pop local 0
push local 1
push constant 1
add
pop local 1
goto DIBUJAR_CICLO
label DIBUJAR_FIN
push constant 0
return

// Grafico.borrarCelda(fila, col): pone la celda en 0.
function Grafico.borrarCelda 2
push argument 0
push argument 1
call Grafico.direccion 2
pop local 0
push local 0
push constant 512
add
pop local 1
label BORRAR_CICLO
push local 0
push local 1
lt
not
if-goto BORRAR_FIN
push local 0
pop pointer 1
push constant 0
pop that 0
push local 0
push constant 32
add
pop local 0
goto BORRAR_CICLO
label BORRAR_FIN
push constant 0
return

// Grafico.desplazarFila(fila): rota las 16 lineas de la fila a la izquierda.
function Grafico.desplazarFila 2
push argument 0
push constant 0
call Grafico.direccion 2
pop local 0
push constant 512
push local 0
add
pop local 1
label DESPLAZAR_CICLO
push local 0
push local 1
eq
if-goto DESPLAZAR_FIN
push local 0
call Grafico.rotarLinea 1
pop temp 0
push local 0
push constant 32
add
pop local 0
goto DESPLAZAR_CICLO
label DESPLAZAR_FIN
push constant 0
return

// Grafico.rotarLinea(dir): rota una linea de 32 palabras a la izquierda.
function Grafico.rotarLinea 3
push argument 0
pop pointer 1
push that 0
pop local 0
push argument 0
pop local 1
push argument 0
push constant 31
add
pop local 2
label ROTAR_CICLO
push local 1
push local 2
eq
if-goto ROTAR_FIN
push local 1
pop pointer 1
push that 1
pop that 0
push local 1
push constant 1
add
pop local 1
goto ROTAR_CICLO
label ROTAR_FIN
push local 2
pop pointer 1
push local 0
pop that 0
push constant 0
return
