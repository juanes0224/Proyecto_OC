// Grafico.vm - Rutinas graficas escritas a mano en lenguaje VM (secciones 9
// y 10 del enunciado). La pantalla se trata como 16 filas x 32 columnas de
// celdas de 16 x 16 pixeles; cada fila de celdas ocupa 16 lineas x 32
// palabras = 512 palabras, y la pantalla empieza en RAM[16384].
// Autor 1: Jeronimo Gutierrez
// Autor 2: Juan Esteban Grisales
// No existe Grafico.jack. No se llama a Memory.poke, Memory.peek ni
// Math.multiply: la memoria se lee y escribe con pointer, this y that.

// Grafico.direccion(fila, col): retorna 16384 + fila*512 + col, la direccion
// de la linea 0 de la celda. fila*512 se calcula sumando 512 tantas veces
// como indique fila (argument 0 se usa como contador).
// local 0 = direccion que se va acumulando.
function Grafico.direccion 1
push constant 16384
push argument 1
add
pop local 0
label DIRECCION_CICLO
push argument 0
push constant 1
lt
if-goto DIRECCION_FIN
push local 0
push constant 512
add
pop local 0
push argument 0
push constant 1
sub
pop argument 0
goto DIRECCION_CICLO
label DIRECCION_FIN
push local 0
return

// Grafico.dibujarCelda(fila, col, sprite): para k = 0..15 copia sprite[k]
// en RAM[16384 + fila*512 + k*32 + col] (linea k de la celda).
// local 0 = direccion en pantalla de la linea k, local 1 = k.
// THIS apunta a sprite[k] (origen) y THAT a la linea k (destino), asi
// "push this 0 / pop that 0" copia una palabra.
function Grafico.dibujarCelda 2
push argument 0
push argument 1
call Grafico.direccion 2
pop local 0
push constant 0
pop local 1
label DIBUJAR_CICLO
push local 1
push constant 16
eq
if-goto DIBUJAR_FIN
push argument 2
push local 1
add
pop pointer 0
push local 0
pop pointer 1
push this 0
pop that 0
push local 0
push constant 32
add
pop local 0
push local 1
push constant 1
add
pop local 1
goto DIBUJAR_CICLO
label DIBUJAR_FIN
push constant 0
return

// Grafico.borrarCelda(fila, col): pone en 0 las 16 palabras de la celda.
// local 0 = direccion de la linea actual, local 1 = primera direccion
// despues de la celda (linea 0 + 16*32 = linea 0 + 512).
function Grafico.borrarCelda 2
push argument 0
push argument 1
call Grafico.direccion 2
pop local 0
push local 0
push constant 512
add
pop local 1
label BORRAR_CICLO
push local 0
push local 1
lt
not
if-goto BORRAR_FIN
push local 0
pop pointer 1
push constant 0
pop that 0
push local 0
push constant 32
add
pop local 0
goto BORRAR_CICLO
label BORRAR_FIN
push constant 0
return

// Grafico.desplazarFila(fila): en cada una de las 16 lineas de la fila de
// celdas rota las 32 palabras una posicion a la izquierda (rotarLinea).
// Sirve para que las lineas divisorias de los carriles se muevan.
// local 0 = inicio de la linea actual, local 1 = linea 0 + 512 (fin).
function Grafico.desplazarFila 2
push argument 0
push constant 0
call Grafico.direccion 2
pop local 0
push constant 512
push local 0
add
pop local 1
label DESPLAZAR_CICLO
push local 0
push local 1
eq
if-goto DESPLAZAR_FIN
push local 0
call Grafico.rotarLinea 1
pop temp 0
push local 0
push constant 32
add
pop local 0
goto DESPLAZAR_CICLO
label DESPLAZAR_FIN
push constant 0
return

// Grafico.rotarLinea(dir): rota a la izquierda las 32 palabras de la linea
// que empieza en dir: w[c] <- w[c+1] para c = 0..30 y w[31] <- w[0].
// local 0 = copia de w[0], local 1 = direccion de w[c], local 2 = dir + 31.
// Con THAT = direccion de w[c], "that 1" es w[c+1] y "that 0" es w[c].
// (El VM Emulator solo deja que THIS apunte al heap; THAT puede apuntar
// a la pantalla.)
function Grafico.rotarLinea 3
push argument 0
pop pointer 1
push that 0
pop local 0
push argument 0
pop local 1
push argument 0
push constant 31
add
pop local 2
label ROTAR_CICLO
push local 1
push local 2
eq
if-goto ROTAR_FIN
push local 1
pop pointer 1
push that 1
pop that 0
push local 1
push constant 1
add
pop local 1
goto ROTAR_CICLO
label ROTAR_FIN
push local 2
pop pointer 1
push local 0
pop that 0
push constant 0
return
