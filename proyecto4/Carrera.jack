/*********
* Carrera.jack - Logica del juego: carro, vidas, puntaje, progreso, estado
* y obstaculos. No dibuja ni lee el teclado.
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class Carrera {
    field int meta, carrilAuto, solicitud;
    field int nVidas, nPuntaje, nProgreso, nEstado, nObstaculos;
    field Array obstaculos, tipos;

    /** Carrera nueva: carril 1, 3 vidas y sin obstaculos. */
    constructor Carrera new(int pasosMeta, int semilla) {
        let meta = pasosMeta;
        let carrilAuto = 1;
        let solicitud = 0;
        let nVidas = 3;
        let nPuntaje = 0;
        let nProgreso = 0;
        let nEstado = 0;
        let nObstaculos = 0;
        let obstaculos = Array.new(20);
        let tipos = Array.new(4);
        // codigo, largo, velocidad, puntos, letal
        let tipos[0] = TipoObstaculo.new(0, 1, 1, 0, true);
        let tipos[1] = TipoObstaculo.new(1, 3, 1, 0, true);
        let tipos[2] = TipoObstaculo.new(2, 1, 2, 0, true);
        let tipos[3] = TipoObstaculo.new(3, 1, 1, 10, false);
        do Aleatorio.semilla(semilla);
        return this;
    }

    /** Libera los obstaculos, los tipos y la carrera. */
    method void dispose() {
        var int i;
        var TipoObstaculo t;
        while (nObstaculos > 0) {
            do eliminar(nObstaculos - 1);
        }
        let i = 0;
        while (i < 4) {
            let t = tipos[i];
            do t.dispose();
            let i = i + 1;
        }
        do obstaculos.dispose();
        do tipos.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Pide un cambio de carril: -1 sube, 1 baja. */
    method void moverCarro(int dir) {
        if ((nEstado = 0) & ((dir = -1) | (dir = 1))) {
            let solicitud = dir;
        }
        return;
    }

    /** Agrega un obstaculo si hay cupo y los datos son validos. */
    method void agregarObstaculo(int tipo, int carril, int col) {
        if ((nObstaculos < 20) & (tipo > -1) & (tipo < 4) & (carril > -1) & (carril < 3)) {
            let obstaculos[nObstaculos] = Obstaculo.new(tipos[tipo], carril, col);
            let nObstaculos = nObstaculos + 1;
        }
        return;
    }

    /** Ejecuta un paso del juego. */
    method void avanzar() {
        if (~(nEstado = 0)) {
            return;
        }
        do cambiarCarril();
        do moverObstaculos();
        do depurar(true);
        if (nVidas = 0) {
            let nEstado = 1;
            return;
        }
        do depurar(false);
        let nProgreso = nProgreso + 1;
        let nPuntaje = nPuntaje + 1;
        if (nProgreso = meta) {
            let nEstado = 2;
        }
        return;
    }

    /** Aplica el cambio de carril pedido. */
    method void cambiarCarril() {
        var int nuevo;
        let nuevo = carrilAuto + solicitud;
        if ((nuevo > -1) & (nuevo < 3)) {
            let carrilAuto = nuevo;
        }
        let solicitud = 0;
        return;
    }

    /** Mueve todos los obstaculos. */
    method void moverObstaculos() {
        var int i;
        var Obstaculo o;
        let i = 0;
        while (i < nObstaculos) {
            let o = obstaculos[i];
            do o.mover();
            let i = i + 1;
        }
        return;
    }

    /** Quita los obstaculos que chocaron o los que salieron. */
    method void depurar(boolean choques) {
        var int i;
        var boolean quitar;
        var Obstaculo o;
        let i = 0;
        while (i < nObstaculos) {
            let o = obstaculos[i];
            if (choques) {
                let quitar = o.toca(carrilAuto, 2);
            } else {
                let quitar = o.salio();
            }
            if (quitar & choques) {
                do aplicarEfecto(o);
            }
            if (quitar) {
                do eliminar(i);
            } else {
                let i = i + 1;
            }
        }
        return;
    }

    /** Resta una vida o suma los puntos del obstaculo. */
    method void aplicarEfecto(Obstaculo o) {
        if (o.esLetal() & (nVidas > 0)) {
            let nVidas = nVidas - 1;
        }
        let nPuntaje = nPuntaje + o.puntos();
        return;
    }

    /** Libera el obstaculo i y pone el ultimo en su lugar. */
    method void eliminar(int i) {
        var Obstaculo o;
        let o = obstaculos[i];
        do o.dispose();
        let nObstaculos = nObstaculos - 1;
        let obstaculos[i] = obstaculos[nObstaculos];
        return;
    }

    /** Agrega a lo sumo un obstaculo en la columna 31. */
    method void generar() {
        var int tipo, carril, intentos;
        if (~(nEstado = 0)) {
            return;
        }
        if (azar(10) > 3) {
            return;
        }
        let tipo = elegirTipo();
        let carril = azar(3);
        let intentos = 0;
        while (intentos < 3) {
            if (permitido(tipo, carril)) {
                do agregarObstaculo(tipo, carril, 31);
                return;
            }
            let carril = carril + 1;
            if (carril = 3) {
                let carril = 0;
            }
            let intentos = intentos + 1;
        }
        return;
    }

    /** Elige un tipo al azar: cono 3, camion 2, moto 2, moneda 3. */
    method int elegirTipo() {
        var int r;
        let r = azar(10);
        if (r < 3) { return 0; }
        if (r < 5) { return 1; }
        if (r < 7) { return 2; }
        return 3;
    }

    /** Revisa la celda libre y la regla de paso libre. */
    method boolean permitido(int tipo, int c) {
        var int otro, bloqueados;
        var TipoObstaculo t;
        if (ocupada(c, 31) > -1) { return false; }
        let t = tipos[tipo];
        if (~t.letal()) { return true; }
        let bloqueados = 0;
        let otro = 0;
        while (otro < 3) {
            if (~(otro = c) & letalCerca(otro)) {
                let bloqueados = bloqueados + 1;
            }
            let otro = otro + 1;
        }
        return bloqueados < 2;
    }

    /** Hay un letal entre las columnas 26 y 31 del carril c. */
    method boolean letalCerca(int c) {
        var int i;
        var boolean hay;
        var Obstaculo o;
        let hay = false;
        let i = 0;
        while (i < nObstaculos) {
            let o = obstaculos[i];
            if (o.esLetal() & o.enRango(c, 26, 31)) {
                let hay = true;
            }
            let i = i + 1;
        }
        return hay;
    }

    /** Numero al azar entre 0 y n - 1. */
    method int azar(int n) {
        var int x;
        let x = (Aleatorio.siguiente() & 32767) / 64;
        return x - ((x / n) * n);
    }

    /** Tipo del obstaculo en la celda, o -1 si esta libre. */
    method int ocupada(int carril, int col) {
        var int i, tipo;
        var Obstaculo o;
        if ((col < 0) | (col > 31)) { return -1; }
        let tipo = -1;
        let i = 0;
        while ((i < nObstaculos) & (tipo = -1)) {
            let o = obstaculos[i];
            if (o.enRango(carril, col, col)) {
                let tipo = o.tipo();
            }
            let i = i + 1;
        }
        return tipo;
    }

    /** Llena el mapa de 96 celdas con el codigo de cada obstaculo. */
    method void llenarMapa(Array mapa) {
        var int i;
        var Obstaculo o;
        let i = 0;
        while (i < 96) {
            let mapa[i] = -1;
            let i = i + 1;
        }
        let i = 0;
        while (i < nObstaculos) {
            let o = obstaculos[i];
            do o.marcar(mapa);
            let i = i + 1;
        }
        return;
    }

    /** Carril del carro. */
    method int carrilCarro() { return carrilAuto; }

    /** Vidas restantes. */
    method int vidas() { return nVidas; }

    /** Puntaje. */
    method int puntaje() { return nPuntaje; }

    /** Pasos completados. */
    method int progreso() { return nProgreso; }

    /** 0 jugando, 1 derrota, 2 victoria. */
    method int estado() { return nEstado; }

    /** Obstaculos activos. */
    method int cantidad() { return nObstaculos; }
}
