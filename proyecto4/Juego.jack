/*********
* Juego.jack - Controla el juego: pantalla inicial, partidas, pausa,
* reinicio y salida.
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class Juego {
    field Vista vista;
    field Teclado teclado;
    field Carrera carrera;
    field int semilla;
    field boolean salir;

    /** Crea la vista y el teclado. */
    constructor Juego new() {
        let vista = Vista.new();
        let teclado = Teclado.new();
        let carrera = null;
        let semilla = 1;
        let salir = false;
        return this;
    }

    /** Libera la vista, el teclado y el juego. */
    method void dispose() {
        do vista.dispose();
        do teclado.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Repite pantalla inicial y partida hasta ESC. */
    method void ejecutar() {
        var int meta;
        while (~salir) {
            let meta = elegirMeta();
            if (meta > 0) {
                do jugar(meta);
            }
        }
        do vista.mostrarDespedida();
        return;
    }

    /** Espera la distancia elegida (1, 2 o 3) o ESC. */
    method int elegirMeta() {
        var int tecla, meta;
        do vista.pantallaInicial();
        let meta = 0;
        while ((meta = 0) & ~salir) {
            let semilla = semilla + 7;
            let tecla = teclado.leer();
            if (tecla = 49) { let meta = 100; }
            if (tecla = 50) { let meta = 250; }
            if (tecla = 51) { let meta = 500; }
            if (tecla = 140) { let salir = true; }
            do Sys.wait(10);
        }
        return meta;
    }

    /** Juega una partida y libera la carrera al final. */
    method void jugar(int meta) {
        var int comando;
        let carrera = Carrera.new(meta, semilla);
        do vista.iniciarCarrera(meta);
        do vista.actualizar(carrera);
        let comando = 0;
        while ((comando = 0) & (carrera.estado() = 0)) {
            let comando = esperarPaso();
            if (comando = 0) {
                do carrera.avanzar();
                do carrera.generar();
                do vista.actualizar(carrera);
            }
        }
        if (comando = 0) {
            let comando = finDePartida();
        }
        if (comando = 140) {
            let salir = true;
        }
        do carrera.dispose();
        let carrera = null;
        return;
    }

    /** Espera un paso leyendo el teclado; retorna R, ESC o 0. */
    method int esperarPaso() {
        var int i, tecla, comando;
        let i = 0;
        let comando = 0;
        while ((i < 5) & (comando = 0)) {
            let tecla = teclado.leer();
            if (tecla = 131) { do carrera.moverCarro(-1); }
            if (tecla = 133) { do carrera.moverCarro(1); }
            if (tecla = 80) { let comando = pausa(); }
            if ((tecla = 82) | (tecla = 140)) { let comando = tecla; }
            do Sys.wait(15);
            let i = i + 1;
        }
        return comando;
    }

    /** Pausa hasta P; retorna R o ESC si se presionan. */
    method int pausa() {
        var int tecla;
        do vista.mostrarPausa(true);
        let tecla = esperarTecla(80, 82, 140);
        do vista.mostrarPausa(false);
        if (tecla = 80) { return 0; }
        return tecla;
    }

    /** Muestra el resultado y espera R, ENTER o ESC. */
    method int finDePartida() {
        var int tecla;
        do vista.mostrarResultado(carrera.estado(), carrera.puntaje());
        let tecla = esperarTecla(82, 128, 140);
        if (tecla = 128) { let tecla = 82; }
        return tecla;
    }

    /** Espera una de las teclas a, b o c. */
    method int esperarTecla(int a, int b, int c) {
        var int tecla;
        let tecla = 0;
        while (~((tecla = a) | (tecla = b) | (tecla = c))) {
            let tecla = teclado.leer();
            do Sys.wait(10);
        }
        return tecla;
    }
}
