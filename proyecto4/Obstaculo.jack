/*********
* Obstaculo.jack - Un obstaculo de la via. Su tipo lo define el
* TipoObstaculo que contiene.
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class Obstaculo {
    field TipoObstaculo datos;
    field int carril, col, colAnterior;

    /** Obstaculo del tipo t en el carril c y la columna x. */
    constructor Obstaculo new(TipoObstaculo t, int c, int x) {
        let datos = t;
        let carril = c;
        let col = x;
        let colAnterior = x;
        return this;
    }

    /** Libera el obstaculo; el tipo lo libera la Carrera. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    /** 0 cono, 1 camion, 2 moto, 3 moneda. */
    method int tipo() { return datos.codigo(); }

    /** Quita una vida al chocar. */
    method boolean esLetal() { return datos.letal(); }

    /** Puntos al chocar. */
    method int puntos() { return datos.puntos(); }

    /** Avanza a la izquierda segun su velocidad. */
    method void mover() {
        let colAnterior = col;
        let col = col - datos.velocidad();
        return;
    }

    /** Ultima columna ocupada empezando en x. */
    method int ultima(int x) { return x + datos.largo() - 1; }

    /** Ocupa alguna columna entre desde y hasta en el carril c. */
    method boolean enRango(int c, int desde, int hasta) {
        return (carril = c) & ~(col > hasta) & ~(ultima(col) < desde);
    }

    /** Paso por la columna x del carril c en el ultimo movimiento. */
    method boolean toca(int c, int x) {
        return (carril = c) & ~(col > x) & ~(ultima(colAnterior) < x);
    }

    /** Salio por la izquierda. */
    method boolean salio() { return ultima(col) < 0; }

    /** Marca sus celdas visibles en el mapa: tipo * 4 + parte. */
    method void marcar(Array mapa) {
        var int parte, x;
        let parte = 0;
        while (parte < datos.largo()) {
            let x = col + parte;
            if ((x > -1) & (x < 32)) {
                let mapa[(carril * 32) + x] = (datos.codigo() * 4) + parte;
            }
            let parte = parte + 1;
        }
        return;
    }
}
