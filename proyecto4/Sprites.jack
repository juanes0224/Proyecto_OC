/*********
* Sprites.jack - Dibujos de 16 x 16 pixeles: un Array de 16 palabras por
* sprite, con el bit 0 como pixel de la izquierda.
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class Sprites {
    field Array tabla;
    field Array arriba, abajo, linea, vacia, llena;

    /** Crea todos los sprites. */
    constructor Sprites new() {
        var int i;
        let tabla = Array.new(17);
        let i = 0;
        while (i < 17) {
            let tabla[i] = null;
            let i = i + 1;
        }
        let tabla[0] = Sprites.crearCono();
        let tabla[4] = Sprites.crearCamionFrente();
        let tabla[5] = Sprites.crearCamionCentro();
        let tabla[6] = Sprites.crearCamionCola();
        let tabla[8] = Sprites.crearMoto();
        let tabla[12] = Sprites.crearMoneda();
        let tabla[16] = Sprites.crearCarro();
        let arriba = Sprites.crearBordeSuperior();
        let abajo = Sprites.crearBordeInferior();
        let linea = Sprites.crearDivisor();
        let vacia = Sprites.crearBarraVacia();
        let llena = Sprites.crearBarraLlena();
        return this;
    }

    /** Libera todos los sprites. */
    method void dispose() {
        var int i;
        var Array s;
        let i = 0;
        while (i < 17) {
            let s = tabla[i];
            if (~(s = null)) {
                do s.dispose();
            }
            let i = i + 1;
        }
        do tabla.dispose();
        do arriba.dispose();
        do abajo.dispose();
        do linea.dispose();
        do vacia.dispose();
        do llena.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Sprite segun el codigo de celda. */
    method Array deCodigo(int codigo) { return tabla[codigo]; }

    /** Borde de arriba de la via. */
    method Array bordeSuperior() { return arriba; }

    /** Borde de abajo de la via. */
    method Array bordeInferior() { return abajo; }

    /** Trazo de las lineas divisorias. */
    method Array divisor() { return linea; }

    /** Celda vacia de la barra de progreso. */
    method Array barraVacia() { return vacia; }

    /** Celda llena de la barra de progreso. */
    method Array barraLlena() { return llena; }

