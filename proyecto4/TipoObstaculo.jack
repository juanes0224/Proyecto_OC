/*********
* TipoObstaculo.jack - Datos que distinguen a un tipo de obstaculo: codigo,
* largo en celdas, velocidad en celdas por paso, puntos que suma y si quita
* una vida. Cono, camion, moto y moneda son cuatro objetos de esta misma
* clase con datos distintos (parametrizacion por datos, tabla 7.3).
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class TipoObstaculo {
    field int nCodigo, nLargo, nVelocidad, nPuntos;
    field boolean esLetal;

    /** Tipo con su codigo (0 cono, 1 camion, 2 moto, 3 moneda), largo,
        velocidad, puntos y letalidad. */
    constructor TipoObstaculo new(int codigo, int largo, int velocidad, int puntos, boolean letal) {
        let nCodigo = codigo;
        let nLargo = largo;
        let nVelocidad = velocidad;
        let nPuntos = puntos;
        let esLetal = letal;
        return this;
    }

    /** Codigo del tipo: 0 cono, 1 camion, 2 moto, 3 moneda. */
    method int codigo() { return nCodigo; }

    /** Cantidad de celdas que ocupa. */
    method int largo() { return nLargo; }

    /** Celdas que avanza hacia la izquierda en cada paso. */
    method int velocidad() { return nVelocidad; }

    /** Puntos que suma al tocar el carro. */
    method int puntos() { return nPuntos; }

    /** true si al tocar el carro le quita una vida. */
    method boolean letal() { return esLetal; }

    /** Libera el objeto (lo hace Carrera.dispose al terminar la carrera). */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
