/*********
* TipoObstaculo.jack - Datos de un tipo de obstaculo: largo, velocidad,
* puntos y si es letal.
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class TipoObstaculo {
    field int nCodigo, nLargo, nVelocidad, nPuntos;
    field boolean esLetal;

    /** Crea un tipo con sus datos. */
    constructor TipoObstaculo new(int codigo, int largo, int velocidad, int puntos, boolean letal) {
        let nCodigo = codigo;
        let nLargo = largo;
        let nVelocidad = velocidad;
        let nPuntos = puntos;
        let esLetal = letal;
        return this;
    }

    /** 0 cono, 1 camion, 2 moto, 3 moneda. */
    method int codigo() { return nCodigo; }

    /** Celdas que ocupa. */
    method int largo() { return nLargo; }

    /** Celdas que avanza por paso. */
    method int velocidad() { return nVelocidad; }

    /** Puntos al chocar. */
    method int puntos() { return nPuntos; }

    /** Quita una vida al chocar. */
    method boolean letal() { return esLetal; }

    /** Libera el tipo. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
