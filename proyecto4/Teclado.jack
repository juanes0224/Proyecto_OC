/*********
* Teclado.jack - Lee el teclado sin detener el juego y reporta cada
* tecla una sola vez.
* Autor 1: Jeronimo Gutierrez
* Autor 2: Juan Esteban Grisales
*********/
class Teclado {
    field int anterior;

    /** Crea el lector de teclado. */
    constructor Teclado new() {
        let anterior = 0;
        return this;
    }

    /** Retorna la tecla recien presionada, o 0. */
    method int leer() {
        var int actual, nueva;
        let actual = Keyboard.keyPressed();
        if ((actual > 96) & (actual < 123)) {
            let actual = actual - 32;
        }
        let nueva = 0;
        if (~(actual = anterior)) {
            let nueva = actual;
        }
        let anterior = actual;
        return nueva;
    }

    /** Libera el objeto. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
